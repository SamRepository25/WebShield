# Public scanner
# Optional standalone backend URL:
# NEXT_PUBLIC_API_URL=https://webshield-api.example.com

# Admin Basic Authentication for dashboard, monitoring and scan history.
# Use a long random password and never expose these as NEXT_PUBLIC_* variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password

# FastAPI backend CORS origin. Set this to the exact public frontend origin.
FRONTEND_ORIGIN=https://webshield-zpv1.onrender.com

# Distributed rate limiting for the public scanner.
# Create an Upstash Redis database and copy these values from its console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Internal protection for scheduler and Telegram test endpoints.
# Use a long random value and keep it server-side. Requests must send either:
# Authorization: Bearer <secret>
# or x-webshield-secret: <secret>
WEBSHIELD_INTERNAL_API_SECRET=

# Optional Telegram integration:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
